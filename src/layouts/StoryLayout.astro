---
import BaseLayout from "./BaseLayout.astro";
import Prose from "../components/Prose.astro"; // the Prose component handles tailwind styling for markdown
const {frontmatter} = Astro.props; // for some reason, `frontmatter` MUST be in curly brackets

// NOTE
// maybe do something to convert the `date` prop to a more human-readable format or to long form
// also this layout as it is now is VERY bare-bones and is only for testing purposes
---

<BaseLayout title={`${frontmatter.title} | Stu's News`} header={frontmatter.title}>
  <div class="flex flex-col gap-8 max-w-200">
    <img
      class="custom-shadow aspect-[16/9] object-cover max-w-200"
      src={frontmatter.image.url}
      alt={frontmatter.image.alt}
    />

    <p class="text-brown/80">
      Written by {frontmatter.author} • {frontmatter.date}
    </p>

    <Prose>
      <slot />
    </Prose>

    <hr class="w-50 text-brown/80"/>

    <div class="flex flex-col gap-1 text-brown/80">
      <p>Image credit: {frontmatter.credits.image}</p>
      
      <!-- only render the ul if there are sources -->
      {frontmatter.credits.sources &&
        <span>Sources:</span>
        <ul class="pl-8">
          {frontmatter.credits.sources.map((source:URL) => (
            <li class="list-disc">
              <a href={source} class="text-sky-600 underline decoration-1 hover:decoration-2">
                {source.toString()}
              </a>
            </li>
          ))}
        </ul>
      }
    </div>
  </div>
</BaseLayout>
